{
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "PRP Evaluation Result",
  "type": "object",
  "properties": {
    "prp_name": {
      "type": "string"
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "quality_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "checks": {
      "type": "object",
      "properties": {
        "has_clear_goal": {
          "type": "boolean"
        },
        "has_verifiable_criteria": {
          "type": "boolean"
        },
        "has_scope_boundaries": {
          "type": "boolean"
        },
        "has_decisions_compliance": {
          "type": "boolean"
        },
        "has_implementation_order": {
          "type": "boolean"
        },
        "has_edge_cases": {
          "type": "boolean"
        },
        "uses_vibekit_test_commands": {
          "type": "boolean"
        }
      }
    },
    "missing_sections": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "suggestions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "execution_result": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        },
        "pdca_iterations": {
          "type": "integer"
        },
        "criteria_passed": {
          "type": "integer"
        },
        "criteria_total": {
          "type": "integer"
        },
        "errors_encountered": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}